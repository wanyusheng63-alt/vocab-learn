honor = 荣誉，尊敬，兑现\"\n  },\n  {\n    word: \"mimic\",\n    phonetic: { uk: \"/ˈmɪmɪk/\", us: \"/ˈmɪmɪk/\" },\n    root: { components: [{ part: \"mimic\", meaning: \"模仿\", origin: \"希腊语 mimos（模仿者）\" }], explanation: \"mimic = 模仿 → 模拟，效仿\" },\n    logic: { premise: \"某种行为或特征存在\", feature: \"复制其外观或行为\", result: \"看起来与原物相似\", essence: \"模仿，模拟\" },\n    usage: [{ context: \"模仿\", example: \"mimic someone's accent\", explanation: \"模仿某人的口音\" }, { context: \"模拟\", example: \"mimic natural processes\", explanation: \"模拟自然过程\" }],\n    distinction: [{ word: \"imitate\", essence: \"模仿（通用）\" }, { word: \"copy\", essence: \"复制\" }, { word: \"mimic\", essence: \"模仿（常含滑稽或精确复制之意）\" }],\n    memory: { methods: [\"mimic 听起来像'咪咪'→ 鹦鹉学舌\", \"联想：mimicry 拟态（生物学）\"], visualHint: \"鹦鹉模仿人说话\" },\n    pitfalls: [\"mimic 常带有'逗趣'或'精确'的意味\", \"生物学中 mimicry = 拟态\"],\n    summary: \"mimic = 模仿，模拟\"\n  },\n  {\n    word: \"deterrence\",\n    phonetic: { uk: \"/dɪˈterəns/\", us: \"/dɪˈtɜːrəns/\" },\n    root: { components: [{ part: \"de-\", meaning: \"远离\", origin: \"\" }, { part: \"terr\", meaning: \"恐惧\", origin: \"拉丁语 terrere\" }, { part: \"-ence\", meaning: \"名词后缀\", origin: \"\" }], explanation: \"deterrence = 使恐惧而远离 → 威慑，遏制\" },\n    logic: { premise: \"存在潜在威胁行为\", feature: \"通过恐惧或惩罚阻止\", result: \"对方不敢行动\", essence: \"通过威吓来阻止\" },\n    usage: [{ context: \"威慑\", example: \"nuclear deterrence\", explanation: \"核威慑\" }, { context: \"遏制\", example: \"crime deterrence\", explanation: \"犯罪遏制\" }],\n    distinction: [{ word: \"prevention\", essence: \"预防（通用）\" }, { word: \"intimidation\", essence: \"恐吓\" }, { word: \"deterrence\", essence: \"威慑（通过恐惧阻止，偏军事/战略）\" }],\n    memory: { methods: [\"de + terr（恐惧）+ ence = 让人害怕而退缩\", \"联想：deter 阻止，deterrence 威慑\"], visualHint: \"导弹发射架——核威慑的象征\" },\n    pitfalls: [\"deterrence 是不可数名词\", \"deterrence 强调'吓阻'而非实际打击\"],\n    summary: \"deterrence = 威慑，遏制\"\n  },\n  {\n    word: \"jurisdiction\",\n    phonetic: { uk: \"/ˌdʒʊərɪsˈdɪkʃn/\", us: \"/ˌdʒʊrɪsˈdɪkʃn/\" }