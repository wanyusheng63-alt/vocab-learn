e: \"a minuscule amount\", explanation: \"极微量的\" }, { context: \"微小的\", example: \"minuscule chances\", explanation: \"极小的机会\" }],\n    distinction: [{ word: \"tiny\", essence: \"微小的\" }, { word: \"minute\", essence: \"极小的\" }, { word: \"minuscule\", essence: \"极小的（强调几乎不存在）\" }],\n    memory: { methods: [\"minus（更小）+ cule = 极小的\", \"联想：minus 减号，minuscule 极小的\"], visualHint: \"显微镜下的细菌\" },\n    pitfalls: [\"minuscule 拼写注意：不是 miniscule\", \"minuscule 比 tiny 更强调'极小'\"],\n    summary: \"minuscule = 极小的，微小的\"\n  },\n  {\n    word: \"confess\",\n    phonetic: { uk: \"/kənˈfes/\", us: \"/kənˈfes/\" },\n    root: { components: [{ part: \"con-\", meaning: \"完全\", origin: \"\" }, { part: \"fess\", meaning: \"说\", origin: \"拉丁语 fateri\" }], explanation: \"confess = 完全说出来 → 坦白，承认\" },\n    logic: { premise: \"某人隐藏了真相或过错\", feature: \"主动承认自己的错误或秘密\", result: \"真相得以公开\", essence: \"主动承认和坦白\" },\n    usage: [{ context: \"坦白\", example: \"confess to the crime\", explanation: \"坦白罪行\" }, { context: \"承认\", example: \"I confess I was wrong\", explanation: \"我承认我错了\" }],\n    distinction: [{ word: \"admit\", essence: \"承认（通用）\" }, { word: \"acknowledge\", essence: \"承认（正式）\" }, { word: \"confess\", essence: \"坦白（对过错或秘密的承认）\" }],\n    memory: { methods: [\"con + fess（说）= 全说出来 → 坦白\", \"联想：profess 声称，confess 坦白\"], visualHint: \"嫌疑人在审讯室低头认罪\" },\n    pitfalls: [\"confess to doing = 坦白做了...\", \"confess 可带宗教色彩（忏悔）\"],\n    summary: \"confess = 坦白，承认\"\n  },\n  {\n    word: \"reciprocation\",\n    phonetic: { uk: \"/rɪˌsɪprəˈkeɪʃn/\", us: \"/rɪˌsɪprəˈkeɪʃn/\" },\n    root: { components: [{ part: \"re-\", meaning: \"回\", origin: \"\" }, { part: \"pro\", meaning: \"向前\", origin: \"\" }, { part: \"-cation\", meaning: \"名词后缀\", origin: \"\" }], explanation: \"reciprocation = 来回的 → 回报，互惠\" },\n    logic: { premise: \"一方给予另一方好处\", feature: \"另一方以同等方式回报\", result: \"形成互惠关系\", essence: \"互相回报的行为\" },\n    usage: [{ context: \"回报\", example: \"expect reciprocation\", explanation: \"期待回报\" }, { con