font-size-label);\n  --text-base: var(--font-size-body);\n}\n\n:root {\n  --radius: 0.75rem;\n\n  /* === 字体排版 === */\n  --font-family: \"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif;\n  --font-family-display: \"Playfair Display\", Georgia, serif;\n  --font-size-display: 3rem;\n  --font-size-headline: 2rem;\n  --font-size-title: 1.5rem;\n  --font-size-body: 1rem;\n  --font-size-label: 0.875rem;\n  --font-size-small: 0.75rem;\n  --font-weight-bold: 700;\n  --font-weight-semibold: 600;\n  --font-weight-medium: 500;\n  --font-weight-normal: 400;\n  --line-height: 1.6;\n\n  /* === 间距系统 === */\n  --spacing-xs: 0.5rem;\n  --spacing-sm: 0.75rem;\n  --spacing-md: 1rem;\n  --spacing-lg: 1.5rem;\n  --spacing-xl: 2rem;\n  --spacing-2xl: 3rem;\n  --spacing-3xl: 4rem;\n\n  /* === 阴影层级 === */\n  --ds-shadow-sm: 0 1px 3px oklch(0.3 0.02 30 / 0.08);\n  --ds-shadow-md: 0 4px 12px oklch(0.3 0.02 30 / 0.10), 0 2px 4px oklch(0.3 0.02 30 / 0.06);\n  --ds-shadow-lg: 0 8px 24px oklch(0.3 0.02 30 / 0.12), 0 4px 8px oklch(0.3 0.02 30 / 0.08);\n  --ds-shadow-xl: 0 16px 48px oklch(0.3 0.02 30 / 0.16), 0 8px 16px oklch(0.3 0.02 30 / 0.10);\n  --shadow-sm: var(--ds-shadow-sm);\n  --shadow-md: var(--ds-shadow-md);\n  --shadow-lg: var(--ds-shadow-lg);\n  --shadow-xl: var(--ds-shadow-xl);\n\n  /* === 动效时间 === */\n  --duration-fast: 150ms;\n  --duration-normal: 200ms;\n  --duration-slow: 300ms;\n  --ease-default: cubic-bezier(0.4, 0, 0.2, 1);\n  --ease-in: cubic-bezier(0.4, 0, 1, 1);\n  --ease-out: cubic-bezier(0, 0, 0.2, 1);\n  --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);\n\n  /* === 温暖学习风格配色 === */\n  /* 背景：温暖的米白色 */\n  --background: oklch(0.98 0.01 80);\n  --foreground: oklch(0.25 0.03 45);\n\n  /* 卡片：纯白 */\n  --card: oklch(1 0 0);\n  --card-foreground: oklch(0.25 0.03 45);\n\n  /* 弹出层 */\n  --popover: oklch(1 0 0);\n  --popover-foreground: oklch(0.25 0.03 45);\n\n  /* 主色：靛蓝色（学习感） */\n  --primary: oklch(0.45 0.12 260);\n  --primary-foreground: oklch(0.98 0 0);\n\n  /* 次要色：温暖的奶油色 */\n  --secondary: oklch(0.95 0.02 80);\n  --secondary-foreground: oklch(0.35 0.04 45);\n\n  /* 柔和色：淡米色 */\n  --muted: oklch(0.94 0.01 80);\n  --muted-foreground: oklch(0.5 0.03 45);\n\n  /* 强调色：温暖的橙色 */\n  --accent: oklch(0.75 0.14 55);\n  --accent-foreground: oklch(0.25 0.03 45);\n\n  /* 危险/错误色 */\n  --destructive: oklch(0.577 0.245 27.325);\n\n  /* 边框和输入框 */\n  --border: oklch(0.88 0.02 80);\n  --input: oklch(0.88 0.02 80);\n  --ring: oklch(0.45 0.12 260);\n\n  /* 功能颜色 */\n  --success: oklch(0.55 0.12 150);\n  --success-foreground: oklch(0.98 0 0);\n  --warning: oklch(0.75 0.14 55);\n  --warning-foreground: oklch(0.25 0 0);\n  --info: oklch(0.55 0.12 230);\n  --info-foreground: oklch(0.98 0 0);\n}\n\n@layer base {\n  * {\n    @apply border-border outline-ring/50;\n  }\n  body {\n    @apply bg-background text-foreground;\n    font-family: var(--font-family);\n  }\n}\n\n/* Tailwind v4: container */\n@utility container {\n  margin-inline: auto;\n  padding-inline: 1rem;\n  @media (width >= 640px) { max-width: 640px; }\n  @media (width >= 768px) { max-width: 768px; }\n  @media (width >= 1024px) { max-width: 1024px; }\n  @media (width >= 1280px) { max-width: 1280px; }\n  @media (width >= 1536px) { max-width: 1536px; }\n}\n\n/* Page Transition System */\n.page-transition {\n  transition:\n    opacity var(--duration-normal, 200ms) var(--ease-default, ease),\n    transform var(--duration-normal, 200ms) var(--ease-default, ease),\n    filter var(--duration-normal, 200ms) var(--ease-default, ease);\n}\n\n.page-transition.fade-out { opacity: 0; }\n.page-transition.fade-in  { opacity: 1; }\n\n.page-transition[data-transition=\"slide-up\"].fade-out {\n  opacity: 0;\n  transform: translateY(24px);\n}\n.page-transition[data-transition=\"slide-up\"].fade-in {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n.page-transition[data-transition=\"scale\"].fade-out {\n  opacity: 0;\n  transform: scale(0.96);\n}\n.page-transition[data-transition=\"scale\"].fade-in {\n  opacity: 1;\n  transform: scale(1);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .page-transition {\n    transition: none !important;\n  }\n}\n\n/* 自定义滚动条 */\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n\n::-webkit-scrollbar-track {\n  background: oklch(0.94 0.01 80);\n}\n\n::-webkit-scrollbar-thumb {\n  background: oklch(0.75 0.04 80);\n  border-radius: 4px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: oklch(0.65 0.05 80);\n}\n"},"tool_response":"Successfully overwrote file: /workspace/frontend/src/index.css","call_id":"Write:6","tool_use_id":"Write:6","permission_mode":"dontAsk","client":"CLI","version":"2.94.0","generation_id":"26a49ff4ecdb46abbfeca93ac0e3769a","model":"kimi-k2.5"}
