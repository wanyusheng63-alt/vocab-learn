ce: \"职业/占领\" }, { word: \"occupancy\", essence: \"入住率，占用（强调使用状态）\" }],\n    memory: { methods: [\"occupy（占据）的名词形式\", \"联想：hotel occupancy = 酒店入住率\"], visualHint: \"酒店楼层亮着灯的房间比例\" },\n    pitfalls: [\"occupancy 强调'使用状态/入住率'\", \"与 occupation（职业）区分\"],\n    summary: \"occupancy = 入住率，占有，占用\"\n  },\n  {\n    word: \"submerge\",\n    phonetic: { uk: \"/səbˈmɜːdʒ/\", us: \"/səbˈmɜːrdʒ/\" },\n    root: { components: [{ part: \"sub-\", meaning: \"在下面\", origin: \"\" }, { part: \"merge\", meaning: \"沉入，融入\", origin: \"拉丁语 mergere\" }], explanation: \"submerge = 沉入水下 → 淹没，浸没\" },\n    logic: { premise: \"物体在水面上\", feature: \"被推入水面以下\", result: \"完全被水覆盖\", essence: \"完全沉入水中\" },\n    usage: [{ context: \"淹没\", example: \"The flood submerged the village.\", explanation: \"洪水淹没了村庄\" }, { context: \"浸没\", example: \"Submerge the vegetables in water.\", explanation: \"把蔬菜浸入水中\" }],\n    distinction: [{ word: \"sink\", essence: \"下沉（自然下沉）\" }, { word: \"drown\", essence: \"淹死（对人）\" }, { word: \"submerge\", essence: \"淹没，浸没（完全在水中）\" }],\n    memory: { methods: [\"sub（下）+ merge（沉入）= 沉入水下\", \"联想：merge（合并）+ sub = 合并到水下\"], visualHint: \"洪水来临时，房屋被水淹没只剩屋顶\" },\n    pitfalls: [\"submerge 强调'完全在水面以下'\", \"也可用于抽象：submerged in work\"],\n    summary: \"submerge = 淹没，浸没，沉入水中\"\n  },\n  {\n    word: \"counter\",\n    phonetic: { uk: \"/ˈkaʊntə(r)/\", us: \"/ˈkaʊntər/\" },\n    root: { components: [{ part: \"count\", meaning: \"计算，对抗\", origin: \"拉丁语 computare\" }], explanation: \"counter = 对抗，反击，柜台，计数器\" },\n    logic: { premise: \"存在某种行动或力量\", feature: \"以相反的行动回应\", result: \"抵消或对抗原有力量\", essence: \"以相反力量对抗\" },\n    usage: [{ context: \"对抗\", example: \"counter the argument\", explanation: \"反驳这个论点\" }, { context: \"柜台\", example: \"a checkout counter\", explanation: \"结账柜台\" }, { context: \"计数器\", example: \"a click counter\", explanation: \"点击计数器\" }],\n    distinction: [{ word: \"oppose\", essence: \"反对\" }, { word: \"resist\", essence: \"抵抗\" }, { word: \"counter\", essence: \"对抗，反击，柜台（多义）\" }],\n    memory: { methods: [\"联想：counter = 相反的\", \"counter- 前缀：counterattack（反击）\"], visualHint: \"棋盘上黑白双方对弈\" },\n    pitfalls: [\"counter 多义词：对抗/柜台/计数器\", \"counter- 可作前缀表示'反'\"],\n    summary: \"counter = 对抗，反击，柜台，计数器\"\n  },\n  {\n    word: \"synchronise\",\n    phonetic: { uk: \"/ˈsɪŋkrənaɪz/\", us: \"/ˈsɪŋkrənaɪz/\" },\n    root: { components: [{ part: \"syn-\", meaning: \"共同\", origin: \"希腊语 syn\" }, { part: \"chron\", meaning: \"时间\", origin: \"希腊语 khronos\" }, { part: \"-ise\", meaning: \"动词后缀\", origin: \"\" }], explanation: \"synchronise = 使时间一致 → 同步\" },\n    logic: { premise: \"多个设备或进程需要协调\", feature: \"使它们在时间上一致\", result: \"保持同步运行\", essence: \"使时间一致化\" },\n    usage: [{ context: \"同步\", example: \"synchronise your phone with the computer\", explanation: \"将手机与电脑同步\" }, { context: \"同步发生\", example: \"The fireworks synchronised with the music.\", explanation: \"烟花与音乐同步\" }],\n    distinction: [{ word: \"coordinate\", essence: \"协调（更广泛）\" }, { word: \"synchronise\", essence: \"同步（时间上完全一致）\" }],\n    memory: { methods: [\"syn（共同）+ chron（时间）= 时间一致\", \"联想：chronology（年代学）\"], visualHint: \"多个钟表显示完全相同的时间\" },\n    pitfalls: [\"英式 synchronise = 美式 synchronize\", \"强调时间上的精确一致\"],\n    summary: \"synchronise = 使同步，使时间一致\"\n  },\n  {\n    word: \"cultivate\",\n    phonetic: { uk: \"/ˈkʌltɪveɪt/\", us: \"/ˈkʌltɪveɪt/\" },\n    root: { components: [{ part: \"cultiv-\", meaning: \"耕种，培育\", origin: \"拉丁语 cultivare\" }, { part: \"-ate\", meaning: \"动词后缀\", origin: \"\" }], explanation: \"cultivate = 耕种 → 培养，培育，发展\" },\n    logic: { premise: \"需要投入时间和精力\", feature: \"像耕种一样精心照料\", result: \"使事物成长发展\", essence: \"精心培育使成长\" },\n    usage: [{ context: \"培养\", example: \"cultivate good habits\", explanation: \"培养好习惯\" }, { context: \"耕种\", example: \"cultivate the land\", explanation: \"耕种土地\" }, { context: \"发展\", example: \"cultivate relationships\", explanation: \"发展关系\" }],\n    distinction: [{ word: \"grow\", essence: \"成长\" }, { word: \"develop\", essence: \"发展\" }, { word: \"cultivate\", essence: \"培养，培育（精心照料）\" }],\n    memory: { methods: [\"词根：cultiv = culture（文化/耕作）\", \"联想：agriculture（农业）的同根词\"], visualHint: \"农民在田里精心培育庄稼\" },\n    pitfalls: [\"cultivate 可指具体耕种或抽象培养\", \"cultivate a relationship = 发展关系\"],\n    summary: \"cultivate = 培养，培育，耕种，发展\"\n  },\n  {\n    word: \"neurotoxic\",\n    phonetic: { uk: \"/ˌnjʊərəʊˈtɒksɪk/\", us: \"/ˌnʊroʊˈtɑːksɪk/\" },\n    root: { components: [{ part: \"neuro-\", meaning: \"神经\", origin: \"希腊语 neuron\" }, { part: \"toxic\", meaning: \"有毒的\", origin: \"希腊语 toxikon\" }], explanation: \"neurotoxic = 对神经有毒的\" },\n    logic: { premise: \"某种物质进入体内\", feature: \"对神经系统造成损害\", result: \"神经功能受损\", essence: \"对神经系统有毒性\" },\n    usage: [{ context: \"神经毒性的\", example: \"neurotoxic effects\", explanation: \"神经毒性效应\" }, { context: \"神经毒素\", example: \"a neurotoxic substance\", explanation: \"一种神经毒性物质\" }],\n    distinction: [{ word: \"toxic\", essence: \"有毒的（一般性）\" }, { word: \"poisonous\", essence: \"有毒的（通用）\" }, { word: \"neurotoxic\", essence: \"神经毒性的（特指神经损害）\" }],\n    memory: { methods: [\"neuro（神经）+ toxic（有毒的）\", \"联想：neurology（神经学）\"], visualHint: \"神经细胞被毒素侵蚀受损\" },\n    pitfalls: [\"neurotoxic 是专业术语\", \"指对神经系统特异性的毒性\"],\n    summary: \"neurotoxic = 神经毒性的，对神经有害的\"\n  },\n  {\n    word: \"flatlined\",\n    phonetic: { uk: \"/ˈflætlaɪnd/\", us: \"/ˈflætlaɪnd/\" },\n    root: { components: [{ part: \"flat\", meaning: \"平的\", origin: \"\" }, { part: \"line\", meaning: \"线\", origin: \"\" }, { part: \"-d\", meaning: \"过去式/形容词\", origin: \"\" }], explanation: \"flatlined = 心电图成平线 → 死亡，停滞\" },\n    logic: { premise: \"心电图从波动变为平线\", feature: \"表示心脏停止跳动\", result: \"临床死亡或完全停滞\", essence: \"从有活力到完全停止\" },\n    usage: [{ context: \"死亡\", example: \"The patient flatlined.\", explanation: \"病人心脏停跳了\" }, { context: \"停滞\", example: \"Sales have flatlined.\", explanation: \"销售已经停滞\" }],\n    distinction: [{ word: \"stopped\", essence: \"停止\" }, { word: \"died\", essence: \"死亡\" }, { word: \"flatlined\", essence: \"死亡，停滞（心电图意象）\" }],\n    memory: { methods: [\"flat（平的）+ line（线）= 平线\", \"联想：心电图变成一条直线\"], visualHint: \"心电监护仪上的波形变成平线\" },\n    pitfalls: [\"flatlined 原指医学上的死亡\", \"引申为'完全停滞'\"],\n    summary: \"flatlined = 死亡，心脏停跳，停滞\"\n  },\n  {\n    word: \"heritage\",\n    phonetic: { uk: \"/ˈherɪtɪdʒ/\", us: \"/ˈherɪtɪdʒ/\" },\n    root: { components: [{ part: \"herit\", meaning: \"继承\", origin: \"拉丁语 heres\" }, { part: \"-age\", meaning: \"名词后缀\", origin: \"\" }], explanation: \"heritage = 继承物 → 遗产，传统\" },\n    logic: { premise: \"先人留下的有价值的财富\", feature: \"代代相传，需要保护\", result: \"成为文化或历史的珍贵遗产\", essence: \"代代相传的珍贵遗产\" },\n    usage: [{ context: \"遗产\", example: \"cultural heritage\", explanation: \"文化遗产\" }, { context: \"传统\", example: \"our national heritage\", explanation: \"我们的民族传统\" }],\n    distinction: [{ word: \"inheritance\", essence: \"继承（个人财产）\" }, { word: \"legacy\", essence: \"遗产/遗赠\" }, { word: \"heritage\", essence: \"遗产，传统（文化/历史层面）\" }],\n    memory: { methods: [\"词根：herit = heir（继承人）\", \"联想：World Heritage Site = 世界遗产地\"], visualHint: \"长城，中国的文化遗产\" },\n    pitfalls: [\"heritage 强调'文化/历史遗产'\", \"与 inheritance（个人继承）区分\"],\n    summary: \"heritage = 遗产，传统，文化继承\"\n  },\n  {\n    word: \"ironically\",\n    phonetic: { uk: \"/aɪˈrɒnɪkli/\", us: \"/aɪˈrɑːnɪkli/\" },\n    root: { components: [{ part: \"ironic\", meaning: \"讽刺的\", origin: \"\" }, { part: \"-ally\", meaning: \"副词后缀\", origin: \"\" }], explanation: \"ironically = 讽刺地，具有讽刺意味的是\" },\n    logic: { premise: \"结果与预期相反\", feature: \"出人意料地反转\", result: \"产生讽刺效果\", essence: \"与预期相反的讽刺\" },\n    usage: [{ context: \"讽刺的是\", example: \"Ironically, the doctor got sick.\", explanation: \"讽刺的是，医生自己病了\" }, { context: \"讽刺地\", example: \"He smiled ironically.\", explanation: \"他讽刺地笑了笑\" }],\n    distinction: [{ word: \"coincidentally\", essence: \"巧合地\" }, { word: \"surprisingly\", essence: \"令人惊讶地\" }, { word: \"ironically\", essence: \"讽刺地（结果与预期相反）\" }],\n    memory: { methods: [\"ironic（讽刺的）+ ally\", \"联想：irony（讽刺）的副词\"], visualHint: \"雨伞广告拍摄当天暴雨倾盆\" },\n    pitfalls: [\"ironically 强调'与预期相反的讽刺'\", \"不是'巧合地'的意思\"],\n    summary: \"ironically = 讽刺地，具有讽刺意味地\"\n  },\n  {\n    word: \"calve\",\n    phonetic: { uk: \"/kɑːv/\", us: \"/kæv/\" },\n    root: { components: [{ part: \"calve\", meaning: \"产犊，崩裂\", origin: \"古英语 cealf\" }], explanation: \"calve = 产犊 → 冰山崩裂\" },\n    logic: { premise: \"冰山或冰川边缘\", feature: \"大块冰从主体断裂脱落\", result: \"形成新的冰山\", essence: \"从主体断裂脱落\" },\n    usage: [{ context: \"冰山崩裂\", example: \"The glacier calved a huge iceberg.\", explanation: \"冰川崩裂出一座巨大的冰山\" }, { context: \"产犊\", example: \"The cow calved yesterday.\", explanation: \"那头牛昨天产犊了\" }],\n    distinction: [{ word: \"break\", essence: \"断裂\" }, { word: \"split\", essence: \"分裂\" }, { word: \"calve\", essence: \"产犊，冰山崩裂（特定用语）\" }],\n    memory: { methods: [\"calve = calf（小牛）的动词\", \"联想：冰山'生'出小冰山\"], visualHint: \"巨大冰川边缘崩落一块，落入海中\" },\n    pitfalls: [\"calve 用于冰川学是专业术语\", \"原意是'产犊'\"],\n    summary: \"calve = 产犊，冰山崩裂\"\n  },\n  {\n    word: \"exceed\",\n    phonetic: { uk: \"/ɪkˈsiːd/\", us: \"/ɪkˈsiːd/\" },\n    root: { components: [{ part: \"ex-\", meaning: \"超出\", origin: \"\" }, { part: \"ceed\", meaning: \"走\", origin: \"拉丁语 cedere\" }], explanation: \"exceed = 走出去 → 超过，超出\" },\n    logic: { premise: \"有设定的限制或标准\", feature: \"实际数量或程度超过限制\", result: \"超出预定范围\", essence: \"超越设定的界限\" },\n    usage: [{ context: \"超过\", example: \"exceed the speed limit\", explanation: \"超速\" }, { context: \"超出\", example: \"The results exceeded expectations.\", explanation: \"结果超出了预期\" }],\n    distinction: [{ word: \"surpass\", essence: \"超越（优胜）\" }, { word: \"overtake\", essence: \"超过（追赶）\" }, { word: \"exceed\", essence: \"超过，超出（超出限制）\" }],\n    memory: { methods: [\"ex + ceed（走）= 走出去/超出\", \"同根词：proceed（前进），succeed（成功）\"], visualHint: \"速度表指针越过了红线限制\" },\n    pitfalls: [\"exceed 强调'超出限制/预期'\", \"exceedingly = 非常，极其\"],\n    summary: \"exceed = 超过，超出\"\n  },\n  {\n    word: \"audience\",\n    p